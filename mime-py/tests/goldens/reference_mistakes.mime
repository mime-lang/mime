$number = {type = i64, abstract = "a whole number that costs $5"}

define $same {$number} -> $number {
  $double = add i64 $number, $number
  ret $double
}
abstract = "the $numbr it is given, a $numberX, the $double, see $same and $later"

define $later {$number} -> $number {
  ret $number
}
abstract = "the \"next\" one, costs \$5"
