@w0 = {type = i64, abstract = "a whole number"}

define @w1 {@w0} -> @w0 {
  %v0 = mul i64 @w0, @w0
  ret %v0
}
abstract = "a @w0 times itself"
symbol = "square"

define @w2 {@w0} -> @w0 {
  %v0 = sub i64 @w0, 1
  ret %v0
}
abstract = "one less than a @w0"
symbol = "less"

define @w3 {@w0} -> @w0 {
  %v0 = sub i64 0, @w0
  ret %v0
}
abstract = "zero minus a @w0"
symbol = "negate"

define @w4 {@w0} -> @w0 {
  %v0 = add i64 @w0, -9223372036854775808
  ret %v0
}
abstract = "a @w0 plus the smallest i64"
symbol = "sum"

@w5 = {type = i64, abstract = "the first of two numbers"}
@w6 = {type = i64, abstract = "the second of two numbers"}

define @w7 {@w5, @w6} -> i64 {
  %v0 = sub i64 @w5, @w6
  ret %v0
}
abstract = "the @w5 minus the @w6, like @w2 but for any two"
symbol = "difference"

define @w8 {} -> @w0 {
  ret 7
}
abstract = "always seven"
symbol = "seven"
