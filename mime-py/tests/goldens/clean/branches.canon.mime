@w0 = {type = i64, abstract = "how far to count"}
@w1 = {type = i1, abstract = "a truth value"}

define @w2 {@w0} -> i64 {
  br ^0{0, 0, @w0}
^0{%0, %1, %2}:
  %3 = icmp sgt i64 %0, %2
  %4 = add i64 %0, 1
  %5 = add i64 %1, %0
  br %3, ^1{%1}, ^0{%4, %5, %2}
^1{%1}:
  ret %1
}
abstract = "the sum of the numbers from 0 to @w0"

define @w3 {@w0} -> @w1 {
  %0 = icmp sgt i64 @w0, 0
  ret %0
}
abstract = "whether @w0 is above zero"

define @w4 {@w1} -> i64 {
  br @w1, ^0{1}, ^0{2}
^0{%0}:
  ret %0
}
abstract = "1 when @w1 holds, otherwise 2"

define @w5 {@w1} -> i1 {
  br @w1, ^0{false}, ^0{true}
^0{%0}:
  ret %0
}
abstract = "the opposite of @w1"
