@w0 = {type = i64, abstract = "a whole number"}

define @w1 {@w0} -> i64 {
  br ^b0{@w0}
^b0{%v0}:
  %v1 = icmp slt i64 %v0, 10
  %v2 = mul i64 %v0, 2
  br %v1, ^b0{%v2}, ^b1{%v0}
^b1{%v0}:
  ret %v0
}
abstract = "the first value of @w0 doubled again and again that is at least 10"
symbol = "leave"

define @w2 {@w0} -> i64 {
  %v0 = add i64 @w0, 1
  br ^b0{%v0}
^b0{%v0}:
  br ^b1{%v0}
^b1{%v0}:
  ret %v0
}
abstract = "one more than @w0, passed through two blocks"
symbol = "chain"

define @w3 {@w0} -> i64 {
  %v0 = add i64 @w0, 1
  br ^b0{0, %v0}
^b0{%v1, %v0}:
  %v2 = icmp sgt i64 %v1, 100
  %v3 = add i64 %v1, %v0
  br %v2, ^b1{%v1}, ^b0{%v3, %v0}
^b1{%v1}:
  ret %v1
}
abstract = "the first multiple of one more than @w0 that is above 100"
symbol = "invariant"

define @w4 {@w0} -> i64 {
  %v0 = icmp eq i64 @w0, 0
  %v1 = add i64 @w0, 1
  %v2 = sub i64 @w0, 1
  br %v0, ^b0{%v1}, ^b0{%v2}
^b0{%v3}:
  ret %v3
}
abstract = "@w0 plus one when @w0 is zero, otherwise @w0 minus one"
symbol = "differ"
